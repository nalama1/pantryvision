# PantryVision Frontend Environment Variables
# Copy this file to .env.local and fill in the values for your deployment.

# API Gateway endpoint URL for the upload-product-photo Lambda
# Format: https://<api-id>.execute-api.<region>.amazonaws.com/<stage>
VITE_API_ENDPOINT=https://your-upload-api-id.execute-api.us-east-1.amazonaws.com/prod

# API Gateway endpoint URL for the extract-product-data Lambda
VITE_EXTRACT_API_ENDPOINT=https://your-extract-api-id.execute-api.us-east-1.amazonaws.com/prod

# API Gateway endpoint URL for the save-product Lambda
VITE_SAVE_API_ENDPOINT=https://your-save-api-id.execute-api.us-east-1.amazonaws.com/prod
